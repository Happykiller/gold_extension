{
  "name": "Gold",
  "description": "Extension Gold",
  "version": "0.7.4",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Gold Extension",
    "default_icon": "medias/logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "*://*.happykiller.net/*",
        "*://*.banquepopulaire.fr/*"
      ],
      "js": [
        "./content/content.js"
      ],
      "all_frames": false,
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "medias/favicon-16x16.png",
    "32": "medias/favicon-32x32.png",
    "64": "medias/favicon-64x64.png",
    "192": "medias/favicon-192x192.png",
    "256": "medias/favicon-256x256.png"
  },
  "content_security_policy": {
    "script-src": "self",
    "object-src": "self",
    "script-src-elem": "self"
  },
  "background": {
    "service_worker": "./background/background.js"
  },
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://localhost/*",
    "*://*.happykiller.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "medias/logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "optional_permissions": []
}